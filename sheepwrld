  const currentSummary = (sheepId) => {
    const list = (feedLog[sheepId] || []).slice().sort((a, b) => new Date(b.date) - new Date(a.date));
    const latest = list[0];
    if (!latest) return "Not set";
    const feedLine = latest.lines.find((l) => l.type === "Feed") || latest.lines[0];
