// =============================================================================
// SHARED UI PRIMITIVES
// =============================================================================
function Field({ label, children, className = "" }) {
  return (
    <div className={className}>
      <div className="text-[10px] uppercase tracking-wider text-neutral-400 mb-1">{label}</div>
      {children}
    </div>
  );
}
function TextInput(props) {
  return (
    <input {...props}
      className={`w-full px-2.5 py-1.5 text-sm outline-none bg-white ${props.className || ""}`}
      style={{ border: `1px solid #DDD8CC`, borderRadius: "2px", color: black, ...(props.style || {}) }}
    />
  );
}
function TextArea(props) {
  return (
    <textarea {...props}
      className={`w-full px-2.5 py-1.5 text-sm outline-none bg-white ${props.className || ""}`}
      style={{ border: `1px solid #DDD8CC`, borderRadius: "2px", color: black, minHeight: 80, ...(props.style || {}) }}
    />
  );
}
function Select({ value, onChange, options, ...rest }) {
  return (
    <select value={value} onChange={onChange} {...rest}
      className="w-full px-2.5 py-1.5 text-sm outline-none bg-white"
      style={{ border: `1px solid #DDD8CC`, borderRadius: "2px", color: black }}>
      {options.map((o) => <option key={o} value={o}>{o}</option>)}
    </select>
  );
}
function GoldButton({ children, onClick, variant = "solid", className = "", ...rest }) {
  const solid = variant === "solid";
  return (
    <button onClick={onClick} {...rest}
      className={`inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium transition-colors ${className}`}
      style={{ background: solid ? black : "#FFFFFF", color: solid ? goldLight : "#555", border: `1px solid ${solid ? black : "#DDD8CC"}`, borderRadius: "2px" }}>
      {children}
    </button>
  );
}
function Card({ children, style = {} }) {
  return <div className="p-5" style={{ background: "#FFFFFF", border: `1px solid ${goldLight}`, borderRadius: "2px", ...style }}>{children}</div>;
}
function SectionLabel({ icon: Icon, children }) {
  return (
    <div className="text-[11px] uppercase tracking-[0.15em] mb-4 flex items-center gap-1.5" style={{ color: gold, fontWeight: 600 }}>
      {Icon && <Icon size={13} />} {children}
    </div>
  );
}

