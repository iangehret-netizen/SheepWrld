// =============================================================================
export default function SheepWrldApp() {
  const [section, setSection] = useState("showbarn"); // showbarn | herd
  const [tab, setTab] = useState("roster");
  const [year, setYear] = useState(new Date().getFullYear().toString());
  const [years, setYears] = useState([]);
  const [loading, setLoading] = useState(true);
  const [herdLoading, setHerdLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState(null);
  const [showAddYear, setShowAddYear] = useState(false);
  const [newYearNum, setNewYearNum] = useState((new Date().getFullYear() + 1).toString());
  const [newYearDesc, setNewYearDesc] = useState("");

  // Show Barn state
  const [exhibitor, setExhibitor] = useState(EMPTY_EXHIBITOR());
  const [sheep, setSheep] = useState([]);
  const [weights, setWeights] = useState({});
  const [healthRecords, setHealthRecords] = useState({});
  const [shows, setShows] = useState([]);
  const [feedLog, setFeedLog] = useState({});
  const [customFeeds, setCustomFeeds] = useState([]);
  const [showResults, setShowResults] = useState([]);

  // Herd state (continuous — not year-scoped)
  const [herdSheep, setHerdSheep] = useState([]);
  const [breeding, setBreeding] = useState([]);
  const [lambing, setLambing] = useState([]);

  // Learn state (global, not year-scoped)
  const [learnNotes, setLearnNotes] = useState([]);
  const [learnLoaded, setLearnLoaded] = useState(false);

  const SHOWBARN_TABS = [
    { id: "roster", label: "Roster" },
    { id: "weights", label: "Weights" },
    { id: "feeds", label: "Feeds" },
    { id: "health", label: "Health Records" },
    { id: "calendar", label: "Show Calendar" },
    { id: "results", label: "Show Results" },
  ];
  const HERD_TABS = [
    { id: "roster", label: "Roster" },
    { id: "breeding", label: "Breeding Records" },
    { id: "lambing", label: "Lambing Records" },
    { id: "learn", label: "Learn" },
  ];

  // ---- Load / persist -------------------------------------------------------
  const loadYear = useCallback(async (y) => {
    setLoading(true);
    setError(null);
    try {
      let ex = EMPTY_EXHIBITOR(), sh = [], wt = {}, hr = {}, sw = [], fl = {}, cf = [], sr = [];
      try {
        const r = await window.storage.get(`sheepwrld:showbarn:${y}`);
        if (r && r.value) {
          const p = JSON.parse(r.value);
          ex = p.exhibitor || ex; sh = p.sheep || []; wt = p.weights || {}; hr = p.records || {}; sw = p.shows || [];
          fl = p.feedLog || {}; cf = p.customFeeds || []; sr = p.showResults || [];
        }
      } catch (e) { /* fresh year */ }
      setExhibitor(ex); setSheep(sh); setWeights(wt); setHealthRecords(hr); setShows(sw);
      setFeedLog(fl); setCustomFeeds(cf); setShowResults(sr);
    } catch (e) {
      setError("Couldn't load records for this year.");
    } finally {
      setLoading(false);
    }
  }, []);

  const loadHerd = useCallback(async () => {
    setHerdLoading(true);
    try {
      let hsh = [], brd = [], lmb = [];
      try {
        const r2 = await window.storage.get("sheepwrld:herd");
        if (r2 && r2.value) {
          const p2 = JSON.parse(r2.value);
          hsh = p2.herdSheep || []; brd = p2.breeding || []; lmb = p2.lambing || [];
        }
      } catch (e) { /* fresh */ }
      setHerdSheep(hsh); setBreeding(brd); setLambing(lmb);
    } finally {
      setHerdLoading(false);
    }
  }, []);

  const persistShowBarn = useCallback(async (ex, sh, wt, hr, sw, fl, cf, sr) => {
    if (typeof window === "undefined" || !window.storage) { setError("Storage isn't available right now — changes are kept for this session only."); return; }
    setSaving(true);
    try {
      await window.storage.set(`sheepwrld:showbarn:${year}`, JSON.stringify({ exhibitor: ex, sheep: sh, weights: wt, records: hr, shows: sw, feedLog: fl, customFeeds: cf, showResults: sr }));
      setError(null);
    } catch (e) { setError("Couldn't save — your changes are still here, but try again if this keeps happening."); }
    finally { setSaving(false); }
  }, [year]);

  const persistHerd = useCallback(async (hsh, brd, lmb) => {
    if (typeof window === "undefined" || !window.storage) { setError("Storage isn't available right now — changes are kept for this session only."); return; }
    setSaving(true);
    try {
      await window.storage.set("sheepwrld:herd", JSON.stringify({ herdSheep: hsh, breeding: brd, lambing: lmb }));
      setError(null);
    } catch (e) { setError("Couldn't save — your changes are still here, but try again if this keeps happening."); }
    finally { setSaving(false); }
  }, []);

  const persistLearn = useCallback(async (notes) => {
    if (typeof window === "undefined" || !window.storage) return;
    try { await window.storage.set("sheepwrld:learn", JSON.stringify(notes)); } catch (e) { /* ignore */ }
  }, []);

  useEffect(() => {
    (async () => {
      try {
        const r = await window.storage.get("sheepwrld:years");
        setYears(r && r.value ? JSON.parse(r.value) : [new Date().getFullYear().toString()]);
      } catch { setYears([new Date().getFullYear().toString()]); }
      try {
        const rl = await window.storage.get("sheepwrld:learn");
        setLearnNotes(rl && rl.value ? JSON.parse(rl.value) : LEARN_STARTERS);
      } catch { setLearnNotes(LEARN_STARTERS); }
      setLearnLoaded(true);
      loadYear(year);
      loadHerd();
    })();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);
  useEffect(() => { loadYear(year); }, [year, loadYear]);

  const saveShowBarn = (ex = exhibitor, sh = sheep, wt = weights, hr = healthRecords, sw = shows, fl = feedLog, cf = customFeeds, sr = showResults) =>
    persistShowBarn(ex, sh, wt, hr, sw, fl, cf, sr);
  const saveHerd = (hsh = herdSheep, brd = breeding, lmb = lambing) => persistHerd(hsh, brd, lmb);

  const submitAddYear = async () => {
    if (!/^\d{4}$/.test(newYearNum.trim())) { setError("Enter a valid 4-digit year."); return; }
    const label = newYearDesc.trim() ? `${newYearNum.trim()} ${newYearDesc.trim()}` : newYearNum.trim();
    if (years.includes(label)) { setYear(label); setShowAddYear(false); return; }
    const next = [...years, label];
    setYears(next);
    try { await window.storage.set("sheepwrld:years", JSON.stringify(next)); } catch {}
    setYear(label);
    setShowAddYear(false);
    setNewYearDesc("");
  };

  // switch section -> reset to first tab of that section
  const switchSection = (s) => { setSection(s); setTab("roster"); };

  const tabs = section === "showbarn" ? SHOWBARN_TABS : HERD_TABS;

  // ---- Excel export (Show Barn only) ----------------------------------------
  const exportExcel = () => {
    const wb = XLSX.utils.book_new();
    const rosterRows = [
      { Field: "Exhibitor", Value: exhibitor.name }, { Field: "4-H Club", Value: exhibitor.club4h },
      { Field: "Age", Value: exhibitor.age }, { Field: "County", Value: exhibitor.county },
      { Field: "# of Sheep", Value: exhibitor.numSheep }, { Field: "Target Show", Value: exhibitor.targetShow },
      { Field: "Target Show Date", Value: exhibitor.targetShowDate }, { Field: "OSF?", Value: exhibitor.osf ? "Yes" : "No" },
      {}, ...sheep.map((s) => ({
        Name: s.name, Sex: s.sex, "L Ear": s.lEar, "R Ear": s.rEar, Birthdate: s.birthdate, Breed: s.breed,
        Sire: s.sire, Dam: s.dam, Breeder: s.breeder, Price: s.price, Showman: s.showman, County: s.county,
        Notes: s.notes, "In Barn": s.inBarn ? "Yes" : "No",
      })),
    ];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rosterRows), "Roster");

    const weightRows = [];
    sheep.forEach((s) => (weights[s.id] || []).forEach((w) => weightRows.push({ Sheep: s.name, Date: w.date, "Weight (lbs)": w.weight })));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(weightRows), "Weights");

    const feedRows = [];
    sheep.forEach((s) => (feedLog[s.id] || []).forEach((entry) => entry.lines.forEach((l) => feedRows.push({
      Sheep: s.name, Date: entry.date, Type: l.type, Product: l.product,
      Amount: l.type === "Feed" ? `${l.lbs || 0} lbs ${l.oz || 0} oz` : l.type === "Supplement" ? `${l.amt || 0} oz` : l.type === "Drench" ? `${l.amt || 0} cc` : `${l.amt || 0} handfuls`,
    }))));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(feedRows), "Feed Log");

    const healthRows = [];
    sheep.forEach((s) => (healthRecords[s.id] || []).forEach((r) => healthRows.push({
      Sheep: s.name, Date: r.date, Type: r.type, Product: r.product, Dose: `${r.doseGiven || ""} ${r.doseUnit || ""}`,
      "Withdrawal (days)": r.withdrawalDays, "Clears On": r.withdrawalDays ? addDays(r.date, r.withdrawalDays) : "", Notes: r.notes,
    })));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(healthRows), "Health Records");

    const showRows = shows.map((s) => ({
      Show: s.name, City: s.city, State: s.state, Date: s.date, Judge: s.judge,
      Attending: (s.attendees || []).map((id) => sheep.find((sh) => sh.id === id)?.name).filter(Boolean).join(", "),
      Notes: s.notes,
    }));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(showRows), "Show Calendar");

    const resultRows = showResults.map((r) => ({
      Show: r.showName, Exhibitor: r.exhibitor, Sheep: sheep.find((s) => s.id === r.sheepId)?.name || "", "Showed As": r.showedAs, Placing: r.placing,
    }));
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(resultRows), "Show Results");

    XLSX.writeFile(wb, `SHEEP WRLD - ${year}.xlsx`);
  };

  // ---- PDF export (Show Barn only, via browser print) ------------------------
  const printRef = useRef(null);
  const exportPDF = () => {
    setTimeout(() => window.print(), 50);
  };

  return (
    <div className="min-h-screen w-full" style={{ background: cream, fontFamily: "'Inter', sans-serif" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Cormorant+Garamond:ital@1&family=Inter:wght@400;500;600&display=swap');
        @media print {
          body * { visibility: hidden; }
          #sheepwrld-print-area, #sheepwrld-print-area * { visibility: visible; }
          #sheepwrld-print-area { position: absolute; top: 0; left: 0; width: 100%; }
        }
      `}</style>

      {/* Header */}
      <div style={{ background: black }} className="w-full">
        <div className="max-w-6xl mx-auto px-6 py-8">
          <div className="flex items-center justify-between flex-wrap gap-4">
            <div>
              <div className="text-xs tracking-[0.35em] uppercase mb-1" style={{ color: goldLight, fontFamily: "'Cormorant Garamond', serif", fontStyle: "italic" }}>
                {section === "showbarn" ? "Show Barn Records" : "Herd Records"}
              </div>
              <h1 className="text-4xl tracking-wide" style={{ fontFamily: "'Playfair Display', serif", color: "#FFFFFF", fontWeight: 600 }}>
                SHEEP WRLD
              </h1>
            </div>
            <div className="flex flex-col items-end gap-2">
              <div className="flex items-center gap-3">
                {saving && <Loader2 size={14} className="animate-spin" style={{ color: goldLight }} />}
                {section === "showbarn" && (
                  <div className="flex items-center gap-1 flex-wrap justify-end">
                    {years.map((y) => (
                      <button key={y} onClick={() => setYear(y)} className="px-3 py-1.5 text-sm"
                        style={{ background: y === year ? gold : "transparent", color: y === year ? black : goldLight, border: `1px solid ${gold}`, borderRadius: "2px", fontWeight: y === year ? 700 : 400 }}>
                        {y}
                      </button>
                    ))}
                    <button onClick={() => setShowAddYear((v) => !v)} className="px-2 py-1.5" style={{ color: goldLight, border: `1px solid ${goldLight}`, borderRadius: "2px" }}>
                      <Plus size={14} />
                    </button>
                  </div>
                )}
              </div>

              {section === "showbarn" && showAddYear && (
                <div className="flex items-end gap-2 p-2" style={{ background: "#242424", border: `1px solid ${goldLight}`, borderRadius: "2px" }}>
                  <div>
                    <div className="text-[9px] uppercase tracking-wider mb-1" style={{ color: goldLight }}>Year</div>
                    <input value={newYearNum} onChange={(e) => setNewYearNum(e.target.value)} placeholder="2026"
                      className="px-2 py-1 text-sm outline-none" style={{ width: 70, border: `1px solid ${goldLight}`, borderRadius: "2px", background: "#FFFFFF" }} />
                  </div>
                  <div>
                    <div className="text-[9px] uppercase tracking-wider mb-1" style={{ color: goldLight }}>Description (optional)</div>
                    <input value={newYearDesc} onChange={(e) => setNewYearDesc(e.target.value)} placeholder="Summer, Fall..."
                      className="px-2 py-1 text-sm outline-none" style={{ width: 130, border: `1px solid ${goldLight}`, borderRadius: "2px", background: "#FFFFFF" }} />
                  </div>
                  <button onClick={submitAddYear} className="px-3 py-1.5 text-xs font-medium" style={{ background: gold, color: black, borderRadius: "2px" }}>
                    <Check size={13} />
                  </button>
                </div>
              )}

              {section === "showbarn" && (
                <div className="flex items-center gap-2">
                  <button onClick={exportPDF} className="px-3 py-1.5 text-xs flex items-center gap-1.5" style={{ color: goldLight, border: `1px solid ${goldLight}`, borderRadius: "2px" }}>
                    <FileDown size={13} /> Generate PDF
                  </button>
                  <button onClick={exportExcel} className="px-3 py-1.5 text-xs flex items-center gap-1.5" style={{ color: goldLight, border: `1px solid ${goldLight}`, borderRadius: "2px" }}>
                    <FileSpreadsheet size={13} /> Generate Excel
                  </button>
                </div>
              )}
            </div>
          </div>

          {/* Section switch */}
          <div className="flex gap-2 mt-6">
            {[{ id: "showbarn", label: "Show Barn" }, { id: "herd", label: "Herd View" }].map((s) => (
              <button key={s.id} onClick={() => switchSection(s.id)}
                className="px-4 py-2 text-sm"
                style={{
                  background: section === s.id ? gold : "transparent",
                  color: section === s.id ? black : goldLight,
                  border: `1px solid ${gold}`, borderRadius: "2px",
                  fontWeight: section === s.id ? 700 : 400,
                }}>
                {s.label}
              </button>
            ))}
          </div>
        </div>
        <div style={{ height: "2px", background: `linear-gradient(90deg, transparent, ${gold}, transparent)` }} />
      </div>

      {/* Sub-tabs */}
      <div className="max-w-6xl mx-auto px-6 pt-6">
        <div className="flex gap-2 mb-6 flex-wrap">
          {tabs.map((t) => (
            <button key={t.id} onClick={() => setTab(t.id)} className="px-4 py-2 text-sm"
              style={{
                background: tab === t.id ? black : "#FFFFFF",
                color: tab === t.id ? goldLight : "#555",
                border: `1px solid ${tab === t.id ? black : "#DDD8CC"}`,
                borderRadius: "2px",
                fontWeight: tab === t.id ? 600 : 400,
              }}>
              {t.label}
            </button>
          ))}
        </div>

        {error && (
          <div className="flex items-center gap-2 mb-4 px-3 py-2 text-sm" style={{ background: "#FBEAEA", border: "1px solid #E0B4B4", borderRadius: "2px", color: "#8C4A4A" }}>
            <AlertCircle size={14} /> {error}
          </div>
        )}

        {(section === "showbarn" ? loading : herdLoading) ? (
          <div className="flex items-center gap-2 py-16 justify-center text-neutral-400 text-sm">
            <Loader2 size={16} className="animate-spin" /> Loading records…
          </div>
        ) : section === "showbarn" ? (
          <ShowBarnSection
            tab={tab}
            exhibitor={exhibitor} setExhibitor={setExhibitor}
            sheep={sheep} setSheep={setSheep}
            weights={weights} setWeights={setWeights}
            healthRecords={healthRecords} setHealthRecords={setHealthRecords}
            shows={shows} setShows={setShows}
            feedLog={feedLog} setFeedLog={setFeedLog}
            customFeeds={customFeeds} setCustomFeeds={setCustomFeeds}
            showResults={showResults} setShowResults={setShowResults}
            saveShowBarn={saveShowBarn}
          />
        ) : (
          <HerdSection
            tab={tab}
            herdSheep={herdSheep} setHerdSheep={setHerdSheep}
            breeding={breeding} setBreeding={setBreeding}
            lambing={lambing} setLambing={setLambing}
            saveHerd={saveHerd}
            learnNotes={learnNotes} setLearnNotes={setLearnNotes}
            persistLearn={persistLearn}
            learnLoaded={learnLoaded}
          />
        )}
      </div>

      <div className="max-w-6xl mx-auto px-6 py-10 text-center">
        <p className="text-[11px] text-neutral-400">
          {section === "showbarn" ? `Show Barn records for ${year} are saved automatically to this browser. Add a year above to start a new season's folder.` : "Herd records are continuous and saved automatically to this browser."} Learn notes are shared across all years.
        </p>
      </div>

      {/* Hidden printable report (Show Barn only) */}
      {section === "showbarn" && (
        <div id="sheepwrld-print-area" style={{ display: "none" }}>
          <PrintableReport year={year} exhibitor={exhibitor} sheep={sheep} weights={weights} healthRecords={healthRecords} shows={shows} feedLog={feedLog} showResults={showResults} />
        </div>
      )}
      <style>{`@media print { #sheepwrld-print-area { display: block !important; } }`}</style>
    </div>
  );
}

