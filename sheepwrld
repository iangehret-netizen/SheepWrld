  );
}

// =============================================================================
// SHOW BARN SECTION
// =============================================================================
function ShowBarnSection({ tab, exhibitor, setExhibitor, sheep, setSheep, weights, setWeights, healthRecords, setHealthRecords, shows, setShows, feedLog, setFeedLog, customFeeds, setCustomFeeds, showResults, setShowResults, saveShowBarn }) {
  const [editingSheepId, setEditingSheepId] = useState(null);
  const [hiddenGraphIds, setHiddenGraphIds] = useState(new Set());
  const [activeSheepId, setActiveSheepId] = useState(sheep[0]?.id || null);
  const [newWeightVal, setNewWeightVal] = useState("");
  const [newWeightDate, setNewWeightDate] = useState(todayISO());

  const [healthActiveSheepId, setHealthActiveSheepId] = useState(sheep[0]?.id || null);
  const [healthEditingId, setHealthEditingId] = useState(null);
  const [healthDraft, setHealthDraft] = useState(EMPTY_HEALTH_RECORD());
  const [showCalc, setShowCalc] = useState(false);
  const [calcWeight, setCalcWeight] = useState("");
  const [calcRateAmt, setCalcRateAmt] = useState("");
  const [calcRatePer, setCalcRatePer] = useState("");
  const [calcUnit, setCalcUnit] = useState("mL");

  const [editingShowId, setEditingShowId] = useState(null);
  const [showDraft, setShowDraft] = useState(EMPTY_SHOW());

  const [feedActiveSheepId, setFeedActiveSheepId] = useState(sheep[0]?.id || null);
  const [feedEditing, setFeedEditing] = useState(false);
  const [feedDraftLines, setFeedDraftLines] = useState([]);
  const [feedDraftDate, setFeedDraftDate] = useState(todayISO());

  const [editingResultId, setEditingResultId] = useState(null);
  const [resultDraft, setResultDraft] = useState(EMPTY_SHOW_RESULT());

  useEffect(() => {
    if (!activeSheepId && sheep[0]) setActiveSheepId(sheep[0].id);
    if (!healthActiveSheepId && sheep[0]) setHealthActiveSheepId(sheep[0].id);
    if (!feedActiveSheepId && sheep[0]) setFeedActiveSheepId(sheep[0].id);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [sheep]);

  // ---- Roster actions ----
  const updateExhibitor = (patch) => { const next = { ...exhibitor, ...patch }; setExhibitor(next); saveShowBarn(next, sheep, weights, healthRecords, shows, feedLog, customFeeds, showResults); };
  const saveExhibitor = () => { saveShowBarn(exhibitor, sheep, weights, healthRecords, shows, feedLog, customFeeds, showResults); };
  const addSheep = () => { const next = [...sheep, EMPTY_SHEEP()]; setSheep(next); setEditingSheepId(next[next.length - 1].id); saveShowBarn(exhibitor, next, weights, healthRecords, shows, feedLog, customFeeds, showResults); };
  const updateSheep = (id, patch) => { const next = sheep.map((s) => (s.id === id ? { ...s, ...patch } : s)); setSheep(next); saveShowBarn(exhibitor, next, weights, healthRecords, shows, feedLog, customFeeds, showResults); };
  const removeSheep = (id) => {
    if (!confirm("Remove this sheep from the roster? This will also delete its weight, health, and feed logs.")) return;
    const next = sheep.filter((s) => s.id !== id);
    const nextWeights = { ...weights }; delete nextWeights[id];
    const nextHealth = { ...healthRecords }; delete nextHealth[id];
    const nextFeed = { ...feedLog }; delete nextFeed[id];
    setSheep(next); setWeights(nextWeights); setHealthRecords(nextHealth); setFeedLog(nextFeed);
    setHiddenGraphIds((prev) => { const s2 = new Set(prev); s2.delete(id); return s2; });
    if (activeSheepId === id) setActiveSheepId(next[0]?.id || null);
    if (healthActiveSheepId === id) setHealthActiveSheepId(next[0]?.id || null);
    if (feedActiveSheepId === id) setFeedActiveSheepId(next[0]?.id || null);
    saveShowBarn(exhibitor, next, nextWeights, nextHealth, shows, nextFeed, customFeeds, showResults);
  };

  // ---- Weight actions ----
  const addWeightEntry = () => {
    if (!activeSheepId || !newWeightVal || isNaN(parseFloat(newWeightVal))) return;
    const entry = { id: uid(), date: newWeightDate, weight: parseFloat(newWeightVal) };
    const list = [...(weights[activeSheepId] || []), entry].sort((a, b) => new Date(a.date) - new Date(b.date));
    const next = { ...weights, [activeSheepId]: list };
    setWeights(next); setNewWeightVal(""); setNewWeightDate(todayISO());
    saveShowBarn(exhibitor, sheep, next, healthRecords, shows, feedLog, customFeeds, showResults);
  };
  const removeWeightEntry = (sheepId, entryId) => {
    const list = (weights[sheepId] || []).filter((e) => e.id !== entryId);
    const next = { ...weights, [sheepId]: list };
    setWeights(next); saveShowBarn(exhibitor, sheep, next, healthRecords, shows, feedLog, customFeeds, showResults);
  };

  const sheepColor = (id) => PALETTE[sheep.findIndex((s) => s.id === id) % PALETTE.length];
  const chartData = useMemo(() => {
    const allDates = new Set();
    sheep.forEach((s) => (weights[s.id] || []).forEach((w) => allDates.add(w.date)));
    const sortedDates = [...allDates].sort((a, b) => new Date(a) - new Date(b));
    return sortedDates.map((date) => {
      const row = { date };
      sheep.forEach((s) => { const e = (weights[s.id] || []).find((w) => w.date === date); if (e) row[s.name || "Unnamed"] = e.weight; });
      return row;
    });
  }, [sheep, weights]);
  const adgStats = (sheepId) => {
    const list = weights[sheepId] || [];
    if (list.length === 0) return { overall: null, recent: null, last: null, first: null };
    const first = list[0], last = list[list.length - 1];
    const overallDays = daysBetween(first.date, last.date);
    const overall = overallDays > 0 ? (last.weight - first.weight) / overallDays : null;
    let recent = null;
    if (list.length >= 2) { const prev = list[list.length - 2]; const d = daysBetween(prev.date, last.date); recent = d > 0 ? (last.weight - prev.weight) / d : null; }
    return { overall, recent, last, first };
  };
  const projection = (s) => {
    const { last } = adgStats(s.id);
    if (!last || !s.targetWeight || !s.targetDate) return null;
    const lbsToGo = parseFloat(s.targetWeight) - last.weight;
    const daysLeft = daysBetween(todayISO(), s.targetDate);
    const lbsPerDayNeeded = daysLeft > 0 ? lbsToGo / daysLeft : null;
    return { lbsToGo, daysLeft, lbsPerDayNeeded };
  };
  const activeSheep = sheep.find((s) => s.id === activeSheepId);

  // ---- Health actions ----
  const startHealthAdd = () => { setHealthDraft(EMPTY_HEALTH_RECORD()); setHealthEditingId("new"); };
  const startHealthEdit = (rec) => { setHealthDraft({ ...rec }); setHealthEditingId(rec.id); };
  const cancelHealthEdit = () => { setHealthEditingId(null); setHealthDraft(EMPTY_HEALTH_RECORD()); setShowCalc(false); };
  const saveHealthDraft = () => {
    if (!healthActiveSheepId || !healthDraft.product) return;
    const list = healthRecords[healthActiveSheepId] || [];
    const exists = list.some((r) => r.id === healthDraft.id);
    const nextList = exists ? list.map((r) => (r.id === healthDraft.id ? healthDraft : r)) : [...list, healthDraft];
    const next = { ...healthRecords, [healthActiveSheepId]: nextList };
    setHealthRecords(next); saveShowBarn(exhibitor, sheep, weights, next, shows, feedLog, customFeeds, showResults); cancelHealthEdit();
  };
  const removeHealthRecord = (id) => {
    if (!confirm("Delete this health record?")) return;
    const next = { ...healthRecords, [healthActiveSheepId]: (healthRecords[healthActiveSheepId] || []).filter((r) => r.id !== id) };
    setHealthRecords(next); saveShowBarn(exhibitor, sheep, weights, next, shows, feedLog, customFeeds, showResults);
  };
  const calcResult = useMemo(() => {
    const w = parseFloat(calcWeight), amt = parseFloat(calcRateAmt), per = parseFloat(calcRatePer);
    if (!w || !amt || !per) return null;
    return (w / per) * amt;
  }, [calcWeight, calcRateAmt, calcRatePer]);
  const applyCalcToDraft = () => { if (calcResult === null) return; setHealthDraft((d) => ({ ...d, doseGiven: calcResult.toFixed(2), doseUnit: calcUnit })); setShowCalc(false); };

  // ---- Show calendar actions ----
  const startShowAdd = () => { setShowDraft(EMPTY_SHOW()); setEditingShowId("new"); };
  const startShowEdit = (sw) => { setShowDraft({ ...sw, attendees: sw.attendees || [] }); setEditingShowId(sw.id); };
  const cancelShowEdit = () => { setEditingShowId(null); setShowDraft(EMPTY_SHOW()); };
  const saveShowDraft = () => {
    if (!showDraft.name) return;
    const exists = shows.some((s) => s.id === showDraft.id);
    const next = exists ? shows.map((s) => (s.id === showDraft.id ? showDraft : s)) : [...shows, showDraft];
    setShows(next); saveShowBarn(exhibitor, sheep, weights, healthRecords, next, feedLog, customFeeds, showResults); cancelShowEdit();
  };
  const removeShow = (id) => {
    if (!confirm("Delete this show?")) return;
    const next = shows.filter((s) => s.id !== id);
    setShows(next); saveShowBarn(exhibitor, sheep, weights, healthRecords, next, feedLog, customFeeds, showResults);
  };

  // ---- Feed log actions ----
  const startFeedUpdate = () => {
    setFeedDraftDate(todayISO());
    setFeedDraftLines(FEED_LINE_TYPES.map((t) => EMPTY_FEED_LINE(t)));
    setFeedEditing(true);
  };
  const cancelFeedUpdate = () => { setFeedEditing(false); setFeedDraftLines([]); };
  const addFeedDraftLine = (type) => setFeedDraftLines((prev) => [...prev, EMPTY_FEED_LINE(type)]);
  const updateFeedDraftLine = (id, patch) => setFeedDraftLines((prev) => prev.map((l) => (l.id === id ? { ...l, ...patch } : l)));
  const removeFeedDraftLine = (id) => setFeedDraftLines((prev) => prev.filter((l) => l.id !== id));
  const saveFeedUpdate = () => {
    if (!feedActiveSheepId) return;
    const nonEmpty = feedDraftLines.filter((l) => l.product && l.product.trim());
    if (nonEmpty.length === 0) return;
    const entry = { id: uid(), date: feedDraftDate, lines: nonEmpty };
    const list = [...(feedLog[feedActiveSheepId] || []), entry].sort((a, b) => new Date(a.date) - new Date(b.date));
    const next = { ...feedLog, [feedActiveSheepId]: list };
    setFeedLog(next); saveShowBarn(exhibitor, sheep, weights, healthRecords, shows, next, customFeeds, showResults);
    cancelFeedUpdate();
  };
  const removeFeedEntry = (sheepId, entryId) => {
    const list = (feedLog[sheepId] || []).filter((e) => e.id !== entryId);
    const next = { ...feedLog, [sheepId]: list };
    setFeedLog(next); saveShowBarn(exhibitor, sheep, weights, healthRecords, shows, next, customFeeds, showResults);
  };
  const addCustomFeed = (cf) => {
    const next = [...customFeeds, cf];
    setCustomFeeds(next); saveShowBarn(exhibitor, sheep, weights, healthRecords, shows, feedLog, next, showResults);
  };

  // ---- Show results actions ----
  const startResultAdd = () => { setResultDraft(EMPTY_SHOW_RESULT()); setEditingResultId("new"); };
  const startResultEdit = (r) => { setResultDraft({ ...r }); setEditingResultId(r.id); };
  const cancelResultEdit = () => { setEditingResultId(null); setResultDraft(EMPTY_SHOW_RESULT()); };
  const saveResultDraft = () => {
    if (!resultDraft.showName) return;
    const exists = showResults.some((r) => r.id === resultDraft.id);
    const next = exists ? showResults.map((r) => (r.id === resultDraft.id ? resultDraft : r)) : [...showResults, resultDraft];
    setShowResults(next); saveShowBarn(exhibitor, sheep, weights, healthRecords, shows, feedLog, customFeeds, next); cancelResultEdit();
  };
  const removeResult = (id) => {
    if (!confirm("Delete this result?")) return;
    const next = showResults.filter((r) => r.id !== id);
    setShowResults(next); saveShowBarn(exhibitor, sheep, weights, healthRecords, shows, feedLog, customFeeds, next);
  };

  if (tab === "roster") {
    return <RosterTab exhibitor={exhibitor} updateExhibitor={updateExhibitor} saveExhibitor={saveExhibitor} sheep={sheep} addSheep={addSheep} updateSheep={updateSheep} removeSheep={removeSheep} editingSheepId={editingSheepId} setEditingSheepId={setEditingSheepId} />;
  }
  if (tab === "weights") {
    return (
      <WeightsTab sheep={sheep} weights={weights} chartData={chartData} sheepColor={sheepColor}
        hiddenGraphIds={hiddenGraphIds} setHiddenGraphIds={setHiddenGraphIds}
        activeSheepId={activeSheepId} setActiveSheepId={setActiveSheepId} activeSheep={activeSheep}
        adgStats={adgStats} projection={projection}
        newWeightVal={newWeightVal} setNewWeightVal={setNewWeightVal} newWeightDate={newWeightDate} setNewWeightDate={setNewWeightDate}
        addWeightEntry={addWeightEntry} removeWeightEntry={removeWeightEntry} updateSheep={updateSheep} />
    );
  }
  if (tab === "feeds") {
    return (
      <FeedsTab sheep={sheep} feedLog={feedLog} customFeeds={customFeeds} addCustomFeed={addCustomFeed}
        activeSheepId={feedActiveSheepId} setActiveSheepId={setFeedActiveSheepId}
        editing={feedEditing} draftLines={feedDraftLines} draftDate={feedDraftDate} setDraftDate={setFeedDraftDate}
        startUpdate={startFeedUpdate} cancelUpdate={cancelFeedUpdate} addLine={addFeedDraftLine} updateLine={updateFeedDraftLine} removeLine={removeFeedDraftLine}
        saveUpdate={saveFeedUpdate} removeEntry={removeFeedEntry} />
    );
  }
  if (tab === "health") {
    return (
      <HealthTab sheep={sheep} records={healthRecords} activeSheepId={healthActiveSheepId} setActiveSheepId={setHealthActiveSheepId}
        editingId={healthEditingId} draft={healthDraft} setDraft={setHealthDraft}
        startAdd={startHealthAdd} startEdit={startHealthEdit} cancelEdit={cancelHealthEdit} saveDraft={saveHealthDraft} removeRecord={removeHealthRecord}
        showCalc={showCalc} setShowCalc={setShowCalc} calcWeight={calcWeight} setCalcWeight={setCalcWeight}
        calcRateAmt={calcRateAmt} setCalcRateAmt={setCalcRateAmt} calcRatePer={calcRatePer} setCalcRatePer={setCalcRatePer}
        calcUnit={calcUnit} setCalcUnit={setCalcUnit} calcResult={calcResult} applyCalcToDraft={applyCalcToDraft} />
    );
  }
  if (tab === "calendar") {
    return (
      <CalendarTab shows={shows} sheep={sheep} editingShowId={editingShowId} showDraft={showDraft} setShowDraft={setShowDraft}
        startShowAdd={startShowAdd} startShowEdit={startShowEdit} cancelShowEdit={cancelShowEdit} saveShowDraft={saveShowDraft} removeShow={removeShow} />
    );
  }
  return (
    <ShowResultsTab sheep={sheep} exhibitor={exhibitor} showResults={showResults}
      editingId={editingResultId} draft={resultDraft} setDraft={setResultDraft}
      startAdd={startResultAdd} startEdit={startResultEdit} cancelEdit={cancelResultEdit} saveDraft={saveResultDraft} removeRecord={removeResult} />
  );
}

// ---- Roster Tab ----
function RosterTab({ exhibitor, updateExhibitor, saveExhibitor, sheep, addSheep, updateSheep, removeSheep, editingSheepId, setEditingSheepId }) {
  const [savedFlash, setSavedFlash] = useState(false);
  const handleSaveExhibitor = () => { saveExhibitor(); setSavedFlash(true); setTimeout(() => setSavedFlash(false), 1500); };
  const visibleCols = [["name", "Name"], ["sex", "Sex"], ["showman", "Showman"]];
  const allCols = [
    ["name", "Name", "text"], ["sex", "Sex", "select"], ["lEar", "L Ear", "text"], ["rEar", "R Ear", "text"],
    ["birthdate", "Birthdate", "date"], ["breed", "Breed", "text"], ["sire", "Sire", "text"], ["dam", "Dam", "text"],
    ["breeder", "Breeder", "text"], ["price", "Price", "text"], ["showman", "Showman", "text"], ["county", "County", "text"], ["notes", "Additional Notes", "text"],
  ];
  return (
    <div className="space-y-6 pb-16">
      <Card>
        <SectionLabel>Exhibitor</SectionLabel>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
          <Field label="Name"><TextInput value={exhibitor.name} onChange={(e) => updateExhibitor({ name: e.target.value })} /></Field>
          <Field label="4-H Club"><TextInput value={exhibitor.club4h} onChange={(e) => updateExhibitor({ club4h: e.target.value })} /></Field>
          <Field label="Age"><TextInput value={exhibitor.age} onChange={(e) => updateExhibitor({ age: e.target.value })} /></Field>
          <Field label="County"><TextInput value={exhibitor.county} onChange={(e) => updateExhibitor({ county: e.target.value })} /></Field>
          <Field label="# of Sheep"><TextInput value={exhibitor.numSheep} onChange={(e) => updateExhibitor({ numSheep: e.target.value })} /></Field>
          <Field label="Target Show"><TextInput value={exhibitor.targetShow} onChange={(e) => updateExhibitor({ targetShow: e.target.value })} /></Field>
          <Field label="Target Show Date"><TextInput type="date" value={exhibitor.targetShowDate} onChange={(e) => updateExhibitor({ targetShowDate: e.target.value })} /></Field>
          <Field label="OSF?">
            <button onClick={() => updateExhibitor({ osf: !exhibitor.osf })} className="w-full px-2.5 py-1.5 text-sm text-left"
              style={{ border: `1px solid #DDD8CC`, borderRadius: "2px", background: exhibitor.osf ? goldLight : "#FFFFFF" }}>
              {exhibitor.osf ? "Yes" : "No"}
            </button>
          </Field>
        </div>
        <div className="flex justify-end mt-4">
          <GoldButton onClick={handleSaveExhibitor}>
            {savedFlash ? <><Check size={13} /> Saved</> : <><Save size={13} /> Save Exhibitor</>}
          </GoldButton>
        </div>
      </Card>

      <Card>
        <div className="flex items-center justify-between mb-4">
          <SectionLabel>Sheep Roster ({sheep.length})</SectionLabel>
          <GoldButton onClick={addSheep}><Plus size={13} /> Add Sheep</GoldButton>
        </div>
        <div className="text-[11px] text-neutral-400 mb-3">
          Showing Name, Sex, and Showman. All other fields are still stored — expand a row to view or edit them.
        </div>
        {sheep.length === 0 ? (
          <div className="text-sm text-neutral-400 text-center py-10">No sheep added yet for this year.</div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-sm border-collapse">
              <thead>
                <tr style={{ borderBottom: `1px solid ${goldLight}` }}>
                  {visibleCols.map(([key, label]) => <th key={key} className="text-left px-2 py-2 text-[10px] uppercase tracking-wider text-neutral-400 whitespace-nowrap">{label}</th>)}
                  <th className="text-left px-2 py-2 text-[10px] uppercase tracking-wider text-neutral-400">In Barn</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {sheep.map((s) => {
                  const editing = editingSheepId === s.id;
                  return (
                    <React.Fragment key={s.id}>
                      <tr style={{ borderBottom: editing ? "none" : "1px solid #EEE9DC", background: editing ? "#FBF6E9" : "transparent" }}>
                        {visibleCols.map(([key]) => (
                          <td key={key} className="px-2 py-2 whitespace-nowrap">
                            <span style={{ color: key === "name" ? black : "#555", fontWeight: key === "name" ? 600 : 400 }}>{s[key] || "—"}</span>
                          </td>
                        ))}
                        <td className="px-2 py-2">
                          <button onClick={() => updateSheep(s.id, { inBarn: !s.inBarn })} className="text-xs px-2 py-0.5"
                            style={{ border: `1px solid ${s.inBarn ? gold : "#DDD8CC"}`, borderRadius: "2px", color: s.inBarn ? gold : "#999" }}>
                            {s.inBarn ? "Active" : "Out"}
                          </button>
                        </td>
                        <td className="px-2 py-2">
                          <div className="flex gap-1">
                            <button onClick={() => setEditingSheepId(editing ? null : s.id)} className="text-xs px-2 py-0.5 flex items-center gap-1"
                              style={{ color: editing ? "#4A6C4A" : gold, border: `1px solid ${editing ? "#4A6C4A" : goldLight}`, borderRadius: "2px" }}>
                              {editing ? <><Save size={12} /> Done</> : <><Pencil size={12} /> Edit</>}
                            </button>
                            <button onClick={() => removeSheep(s.id)} className="text-xs px-1.5 py-0.5 text-red-400 hover:text-red-600"><Trash2 size={13} /></button>
                          </div>
                        </td>
                      </tr>
                      {editing && (
                        <tr style={{ borderBottom: "1px solid #EEE9DC", background: "#FBF6E9" }}>
                          <td colSpan={visibleCols.length + 2} className="px-2 pb-4 pt-1">
                            <div className="grid grid-cols-2 md:grid-cols-4 gap-3 p-3" style={{ background: "#FFFFFF", border: `1px solid ${goldLight}`, borderRadius: "2px" }}>
                              {allCols.map(([key, label, type]) => (
                                <Field label={label} key={key}>
                                  {key === "sex" ? (
                                    <Select value={s.sex} onChange={(e) => updateSheep(s.id, { sex: e.target.value })} options={["Wether", "Ewe", "Ram"]} />
                                  ) : (
                                    <TextInput type={type} value={s[key]} onChange={(e) => updateSheep(s.id, { [key]: e.target.value })} />
                                  )}
                                </Field>
                              ))}
                            </div>
                          </td>
                        </tr>
                      )}
                    </React.Fragment>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </Card>
    </div>
  );
}

// ---- Weights Tab ----
function WeightsTab({ sheep, weights, chartData, sheepColor, hiddenGraphIds, setHiddenGraphIds, activeSheepId, setActiveSheepId, activeSheep, adgStats, projection, newWeightVal, setNewWeightVal, newWeightDate, setNewWeightDate, addWeightEntry, removeWeightEntry, updateSheep }) {
  const toggleGraph = (id) => setHiddenGraphIds((prev) => { const next = new Set(prev); next.has(id) ? next.delete(id) : next.add(id); return next; });
  if (sheep.length === 0) return <div className="text-sm text-neutral-400 text-center py-16">Add sheep to the roster first to begin tracking weights.</div>;
  const activeStats = activeSheep ? adgStats(activeSheep.id) : null;
  const activeProj = activeSheep ? projection(activeSheep) : null;
  return (
    <div className="space-y-6 pb-16">
      <Card>
        <div className="flex items-center justify-between mb-3 flex-wrap gap-2">
          <SectionLabel icon={TrendingUp}>Weight Trajectory</SectionLabel>
          <div className="flex flex-wrap gap-1.5">
            {sheep.map((s) => {
              const visible = !hiddenGraphIds.has(s.id);
              return (
                <button key={s.id} onClick={() => toggleGraph(s.id)} className="px-2 py-0.5 text-[11px] flex items-center gap-1"
                  style={{ border: `1px solid ${visible ? sheepColor(s.id) : "#DDD8CC"}`, borderRadius: "2px", opacity: visible ? 1 : 0.4 }}>
                  <span style={{ width: 8, height: 8, borderRadius: 999, background: sheepColor(s.id), display: "inline-block" }} />
                  {s.name || "Unnamed"}
                </button>
              );
            })}
          </div>
        </div>
        <div style={{ width: "100%", height: 320 }}>
          <ResponsiveContainer>
            <LineChart data={chartData} margin={{ top: 8, right: 16, left: -8, bottom: 8 }}>
              <CartesianGrid stroke="#EEE9DC" />
              <XAxis dataKey="date" tick={{ fontSize: 11, fill: "#999" }} label={{ value: "Date", position: "insideBottom", offset: -4, fontSize: 11, fill: "#999" }} />
              <YAxis domain={[50, 200]} ticks={WEIGHT_TICKS} tick={{ fontSize: 11, fill: "#999" }} label={{ value: "Weight (lbs)", angle: -90, position: "insideLeft", fontSize: 11, fill: "#999" }} />
              <Tooltip contentStyle={{ fontSize: 12, borderRadius: 2, borderColor: goldLight }} />
              <Legend wrapperStyle={{ fontSize: 11 }} />
              {sheep.filter((s) => !hiddenGraphIds.has(s.id)).map((s) => (
                <Line key={s.id} type="monotone" dataKey={s.name || "Unnamed"} stroke={sheepColor(s.id)} strokeWidth={2} dot={{ r: 3 }} connectNulls />
              ))}
            </LineChart>
          </ResponsiveContainer>
        </div>
      </Card>

      <div className="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-4">
        <div className="p-3" style={{ background: "#FFFFFF", border: `1px solid ${goldLight}`, borderRadius: "2px", maxHeight: 480, overflowY: "auto" }}>
          {sheep.map((s) => (
            <button key={s.id} onClick={() => setActiveSheepId(s.id)} className="w-full text-left px-2.5 py-2 text-sm flex items-center gap-2 mb-1"
              style={{ background: activeSheepId === s.id ? cream : "transparent", borderLeft: `3px solid ${activeSheepId === s.id ? sheepColor(s.id) : "transparent"}`, borderRadius: "2px", color: black, fontWeight: activeSheepId === s.id ? 600 : 400 }}>
              <span style={{ width: 8, height: 8, borderRadius: 999, background: sheepColor(s.id), flexShrink: 0 }} />
              {s.name || "Unnamed"}
            </button>
          ))}
        </div>

        {activeSheep && (
          <Card>
            <div className="flex items-center justify-between mb-4">
              <h3 className="text-xl" style={{ fontFamily: "'Playfair Display', serif", color: black }}>{activeSheep.name || "Unnamed"}</h3>
              <GoldButton onClick={() => setActiveSheepId(null)}>Done</GoldButton>
            </div>

            <div className="grid grid-cols-3 gap-3 mb-5">
              <div className="p-3" style={{ background: cream, borderRadius: "2px" }}>
                <div className="text-[10px] uppercase tracking-wider text-neutral-400">Current Weight</div>
                <div className="text-lg font-semibold" style={{ color: black }}>{activeStats?.last ? `${activeStats.last.weight} lbs` : "—"}</div>
              </div>
              <div className="p-3" style={{ background: cream, borderRadius: "2px" }}>
                <div className="text-[10px] uppercase tracking-wider text-neutral-400">Overall ADG</div>
                <div className="text-lg font-semibold" style={{ color: black }}>{fmtNum(activeStats?.overall)} lb/day</div>
              </div>
              <div className="p-3" style={{ background: cream, borderRadius: "2px" }}>
                <div className="text-[10px] uppercase tracking-wider text-neutral-400">ADG Since Last</div>
                <div className="text-lg font-semibold" style={{ color: black }}>{fmtNum(activeStats?.recent)} lb/day</div>
              </div>
            </div>

            <div className="mb-5">
              <SectionLabel icon={Target}>Show Day Target</SectionLabel>
              <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mb-3">
                <Field label="Target Weight (lbs)"><TextInput value={activeSheep.targetWeight} onChange={(e) => updateSheep(activeSheep.id, { targetWeight: e.target.value })} /></Field>
                <Field label="Target Show Date"><TextInput type="date" value={activeSheep.targetDate} onChange={(e) => updateSheep(activeSheep.id, { targetDate: e.target.value })} /></Field>
                <Field label="Lbs To Go"><div className="px-2.5 py-1.5 text-sm" style={{ color: black, fontWeight: 600 }}>{activeProj ? fmtNum(activeProj.lbsToGo, 1) : "—"}</div></Field>
                <Field label="Lbs/Day Needed"><div className="px-2.5 py-1.5 text-sm" style={{ color: black, fontWeight: 600 }}>{activeProj ? fmtNum(activeProj.lbsPerDayNeeded) : "—"}</div></Field>
              </div>
              {activeProj && activeStats?.recent !== null && activeStats?.recent !== undefined && (
                <div className="text-xs px-3 py-2 inline-block" style={{ borderRadius: "2px", background: activeStats.recent >= activeProj.lbsPerDayNeeded ? "#EAF3EA" : "#FBEAEA", color: activeStats.recent >= activeProj.lbsPerDayNeeded ? "#4A6C4A" : "#8C4A4A" }}>
                  {activeStats.recent >= activeProj.lbsPerDayNeeded ? `On track — current pace covers the ${fmtNum(activeProj.lbsPerDayNeeded)} lb/day needed.` : `Behind pace — need ${fmtNum(activeProj.lbsPerDayNeeded)} lb/day, currently gaining ${fmtNum(activeStats.recent)}.`}
                </div>
              )}
            </div>

            <div>
              <SectionLabel icon={Calendar}>Log a Weigh-In</SectionLabel>
              <div className="flex items-end gap-2 mb-4">
                <Field label="Date"><TextInput type="date" value={newWeightDate} onChange={(e) => setNewWeightDate(e.target.value)} /></Field>
                <Field label="Weight (lbs)"><TextInput type="number" value={newWeightVal} onChange={(e) => setNewWeightVal(e.target.value)} /></Field>
                <GoldButton onClick={addWeightEntry}><Plus size={13} /> Add</GoldButton>
              </div>
              <div className="space-y-1 max-h-56 overflow-y-auto">
                {(weights[activeSheep.id] || []).slice().reverse().map((w) => (
                  <div key={w.id} className="flex items-center justify-between px-3 py-1.5 text-sm" style={{ background: cream, borderRadius: "2px" }}>
                    <span className="text-neutral-500">{w.date}</span>
                    <span style={{ color: black, fontWeight: 600 }}>{w.weight} lbs</span>
                    <button onClick={() => removeWeightEntry(activeSheep.id, w.id)} className="text-red-400 hover:text-red-600"><X size={13} /></button>
                  </div>
                ))}
                {(weights[activeSheep.id] || []).length === 0 && <div className="text-xs text-neutral-400 text-center py-4">No weigh-ins logged yet.</div>}
              </div>
            </div>
          </Card>
        )}
      </div>
    </div>
  );
}

// ---- Feeds Tab (Feed Catalogue lookup) ----
function formatFeedAmount(line) {
  if (line.type === "Feed") return `${line.lbs || 0} lb ${line.oz || 0} oz`;
  if (line.type === "Supplement") return `${line.amt || 0} oz`;
  if (line.type === "Drench") return `${line.amt || 0} cc`;
  return `${line.amt || 0} handfuls`;
}

function ProductPicker({ value, onChange, customFeeds, onAddCustom }) {
  const [addingCustom, setAddingCustom] = useState(false);
  const [cf, setCf] = useState(EMPTY_CUSTOM_FEED());

  const handleChange = (e) => {
    const v = e.target.value;
    if (v === "__addcustom__") { setAddingCustom(true); return; }
    onChange(v);
  };

  const submitCustom = () => {
    if (!cf.name.trim()) return;
    onAddCustom(cf);
    onChange(cf.name.trim());
    setAddingCustom(false);
    setCf(EMPTY_CUSTOM_FEED());
  };

  return (
    <div>
      <select value={FEEDS.some((f) => `${f.c} – ${f.n}` === value) || customFeeds.some((c) => c.name === value) ? value : (value ? "__other__" : "")}
        onChange={handleChange} className="w-full px-2.5 py-1.5 text-sm outline-none bg-white"
        style={{ border: `1px solid #DDD8CC`, borderRadius: "2px", color: black }}>
        <option value="">Select a feed/supplement...</option>
        {value && !FEEDS.some((f) => `${f.c} – ${f.n}` === value) && !customFeeds.some((c) => c.name === value) && (
          <option value="__other__">{value}</option>
        )}
        <option value="__addcustom__">+ Add Custom Feed...</option>
        {customFeeds.length > 0 && (
          <optgroup label="Custom Feeds">
            {customFeeds.map((c) => <option key={c.id} value={c.name}>{c.name}</option>)}
          </optgroup>
        )}
        {FEED_COMPANIES.map((co) => (
          <optgroup key={co} label={co}>
            {FEEDS.filter((f) => f.c === co).map((f) => <option key={f.n} value={`${f.c} – ${f.n}`}>{f.n}</option>)}
          </optgroup>
        ))}
      </select>

      {addingCustom && (
        <div className="mt-2 p-3" style={{ background: cream, border: `1px solid ${goldLight}`, borderRadius: "2px" }}>
          <div className="grid grid-cols-2 gap-2 mb-2">
            <TextInput placeholder="Feed name" value={cf.name} onChange={(e) => setCf({ ...cf, name: e.target.value })} />
            <Select value={cf.category} onChange={(e) => setCf({ ...cf, category: e.target.value })} options={["Feed", "Supplement", "Drench", "Hay", "Other"]} />
          </div>
          <div className="grid grid-cols-3 gap-2 mb-2">
            <TextInput placeholder="CP %" value={cf.cp} onChange={(e) => setCf({ ...cf, cp: e.target.value })} />
            <TextInput placeholder="Fat %" value={cf.fat} onChange={(e) => setCf({ ...cf, fat: e.target.value })} />
            <TextInput placeholder="Fiber %" value={cf.fib} onChange={(e) => setCf({ ...cf, fib: e.target.value })} />
          </div>
          <TextInput placeholder="Intended use (optional)" value={cf.use} onChange={(e) => setCf({ ...cf, use: e.target.value })} className="mb-2" />
          <div className="flex justify-end gap-2">
            <GoldButton variant="outline" onClick={() => setAddingCustom(false)}>Cancel</GoldButton>
            <GoldButton onClick={submitCustom}>Add Feed</GoldButton>
          </div>
        </div>
      )}
    </div>
  );
}

function FeedLineRow({ line, onUpdate, onRemove, customFeeds, onAddCustom }) {
  return (
    <div className="p-3 mb-2" style={{ background: "#FFFFFF", border: `1px solid #DDD8CC`, borderRadius: "2px" }}>
      <div className="flex items-center justify-between mb-2">
        <span className="text-[10px] uppercase tracking-wider font-semibold" style={{ color: gold }}>{line.type}</span>
        <button onClick={onRemove} className="text-neutral-400 hover:text-red-500"><X size={13} /></button>
      </div>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-2">
        <div className="md:col-span-2">
          <ProductPicker value={line.product} onChange={(v) => onUpdate({ product: v })} customFeeds={customFeeds} onAddCustom={onAddCustom} />
        </div>
        {line.type === "Feed" && (
          <div className="flex gap-2">
            <TextInput type="number" placeholder="lbs" value={line.lbs} onChange={(e) => onUpdate({ lbs: e.target.value })} />
            <TextInput type="number" placeholder="oz" value={line.oz} onChange={(e) => onUpdate({ oz: e.target.value })} />
          </div>
        )}
        {line.type === "Supplement" && <TextInput type="number" placeholder="oz" value={line.amt} onChange={(e) => onUpdate({ amt: e.target.value })} />}
        {line.type === "Drench" && <TextInput type="number" placeholder="cc" value={line.amt} onChange={(e) => onUpdate({ amt: e.target.value })} />}
        {line.type === "Hay" && <TextInput type="number" placeholder="handfuls" value={line.amt} onChange={(e) => onUpdate({ amt: e.target.value })} />}
      </div>
    </div>
  );
}

// ---- Feeds Tab (per-sheep feed program tracker) ----
