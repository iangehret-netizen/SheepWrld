// HERD SECTION
// =============================================================================
function HerdSection({ tab, herdSheep, setHerdSheep, breeding, setBreeding, lambing, setLambing, saveHerd, learnNotes, setLearnNotes, persistLearn, learnLoaded }) {
  const [editingHerdId, setEditingHerdId] = useState(null);
  const [editingBreedingId, setEditingBreedingId] = useState(null);
  const [breedingDraft, setBreedingDraft] = useState(EMPTY_BREEDING());
  const [editingLambId, setEditingLambId] = useState(null);
  const [lambDraft, setLambDraft] = useState(EMPTY_LAMB());

  const addHerdSheep = () => { const next = [...herdSheep, EMPTY_HERD_SHEEP()]; setHerdSheep(next); setEditingHerdId(next[next.length - 1].id); saveHerd(next, breeding, lambing); };
  const updateHerdSheep = (id, patch) => { const next = herdSheep.map((s) => (s.id === id ? { ...s, ...patch } : s)); setHerdSheep(next); saveHerd(next, breeding, lambing); };
  const removeHerdSheep = (id) => { if (!confirm("Remove this animal from the herd roster?")) return; const next = herdSheep.filter((s) => s.id !== id); setHerdSheep(next); saveHerd(next, breeding, lambing); };

  const startBreedingAdd = () => { setBreedingDraft(EMPTY_BREEDING()); setEditingBreedingId("new"); };
  const startBreedingEdit = (b) => { setBreedingDraft({ ...b }); setEditingBreedingId(b.id); };
  const cancelBreedingEdit = () => { setEditingBreedingId(null); setBreedingDraft(EMPTY_BREEDING()); };
  const saveBreedingDraft = () => {
    if (!breedingDraft.ewe) return;
    const exists = breeding.some((b) => b.id === breedingDraft.id);
    const next = exists ? breeding.map((b) => (b.id === breedingDraft.id ? breedingDraft : b)) : [...breeding, breedingDraft];
    setBreeding(next); saveHerd(herdSheep, next, lambing); cancelBreedingEdit();
  };
  const removeBreeding = (id) => { if (!confirm("Delete this breeding record?")) return; const next = breeding.filter((b) => b.id !== id); setBreeding(next); saveHerd(herdSheep, next, lambing); };

  const startLambAdd = () => { setLambDraft(EMPTY_LAMB()); setEditingLambId("new"); };
  const startLambEdit = (l) => { setLambDraft({ ...l }); setEditingLambId(l.id); };
  const cancelLambEdit = () => { setEditingLambId(null); setLambDraft(EMPTY_LAMB()); };
  const saveLambDraft = () => {
    if (!lambDraft.tag && !lambDraft.dam) return;
    const exists = lambing.some((l) => l.id === lambDraft.id);
    const next = exists ? lambing.map((l) => (l.id === lambDraft.id ? lambDraft : l)) : [...lambing, lambDraft];
    setLambing(next); saveHerd(herdSheep, breeding, next); cancelLambEdit();
  };
  const removeLamb = (id) => { if (!confirm("Delete this lambing record?")) return; const next = lambing.filter((l) => l.id !== id); setLambing(next); saveHerd(herdSheep, breeding, next); };

  const addLearnNote = () => {
    const note = { id: uid(), category: "Care", title: "", body: "" };
    const next = [note, ...learnNotes];
    setLearnNotes(next); persistLearn(next);
    return note.id;
  };
  const updateLearnNote = (id, patch) => { const next = learnNotes.map((n) => (n.id === id ? { ...n, ...patch } : n)); setLearnNotes(next); persistLearn(next); };
  const removeLearnNote = (id) => { if (!confirm("Delete this note?")) return; const next = learnNotes.filter((n) => n.id !== id); setLearnNotes(next); persistLearn(next); };

  if (tab === "roster") return <HerdRosterTab herdSheep={herdSheep} addHerdSheep={addHerdSheep} updateHerdSheep={updateHerdSheep} removeHerdSheep={removeHerdSheep} editingHerdId={editingHerdId} setEditingHerdId={setEditingHerdId} />;
  if (tab === "breeding") return <BreedingTab herdSheep={herdSheep} breeding={breeding} editingId={editingBreedingId} draft={breedingDraft} setDraft={setBreedingDraft} startAdd={startBreedingAdd} startEdit={startBreedingEdit} cancelEdit={cancelBreedingEdit} saveDraft={saveBreedingDraft} removeRecord={removeBreeding} />;
  if (tab === "lambing") return <LambingTab lambing={lambing} editingId={editingLambId} draft={lambDraft} setDraft={setLambDraft} startAdd={startLambAdd} startEdit={startLambEdit} cancelEdit={cancelLambEdit} saveDraft={saveLambDraft} removeRecord={removeLamb} />;
  return <LearnTab notes={learnNotes} loaded={learnLoaded} addNote={addLearnNote} updateNote={updateLearnNote} removeNote={removeLearnNote} />;
}

