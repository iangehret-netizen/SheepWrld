// ---- Learn Tab ----
function LearnTab({ notes, loaded, addNote, updateNote, removeNote }) {
  const [editingId, setEditingId] = useState(null);
  const [filter, setFilter] = useState("All");
  const categories = ["All", "Breeding", "Lambing", "Care", "Standards"];

  const handleAdd = () => { const id = addNote(); setEditingId(id); setFilter("All"); };
  const filtered = notes.filter((n) => filter === "All" || n.category === filter);

  return (
    <div className="pb-16">
      <div className="flex items-center justify-between mb-4 flex-wrap gap-3">
        <SectionLabel icon={BookOpen}>Learn — Breeding, Lambing & Care Standards</SectionLabel>
        <GoldButton onClick={handleAdd}><Plus size={13} /> Add Note</GoldButton>
      </div>

      <div className="flex flex-wrap gap-2 mb-5">
        {categories.map((c) => (
          <button key={c} onClick={() => setFilter(c)} className="px-3 py-1 text-xs transition-colors"
            style={{ border: `1px solid ${filter === c ? gold : "#DDD8CC"}`, borderRadius: "2px", background: filter === c ? black : "#FFFFFF", color: filter === c ? goldLight : "#555", fontWeight: filter === c ? 600 : 400 }}>
            {c}
          </button>
        ))}
      </div>

      <div className="mb-5 px-3 py-2 text-xs flex items-center gap-2" style={{ background: cream, border: `1px solid ${goldLight}`, borderRadius: "2px", color: "#6B6B6B" }}>
        <ExternalLink size={12} style={{ color: gold }} />
        For specialized breeding/reproduction help (AI, ET, IVF), Reproductive Specialty Group is a useful resource: reprospecialty.com
      </div>

      {!loaded ? (
        <div className="flex items-center gap-2 py-10 justify-center text-neutral-400 text-sm"><Loader2 size={16} className="animate-spin" /> Loading notes…</div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
          {filtered.map((n) => {
            const editing = editingId === n.id;
            return (
              <div key={n.id} className="p-4" style={{ background: "#FFFFFF", border: `1px solid ${goldLight}`, borderRadius: "2px" }}>
                {editing ? (
                  <div className="space-y-2">
                    <Select value={n.category} onChange={(e) => updateNote(n.id, { category: e.target.value })} options={["Breeding", "Lambing", "Care", "Standards"]} />
                    <TextInput value={n.title} onChange={(e) => updateNote(n.id, { title: e.target.value })} placeholder="Title" />
                    <TextArea value={n.body} onChange={(e) => updateNote(n.id, { body: e.target.value })} placeholder="Notes..." />
                    <div className="flex justify-end gap-2">
                      <GoldButton variant="outline" onClick={() => removeNote(n.id)}><Trash2 size={12} /> Delete</GoldButton>
                      <GoldButton onClick={() => setEditingId(null)}><Save size={12} /> Done</GoldButton>
                    </div>
                  </div>
                ) : (
                  <div onClick={() => setEditingId(n.id)} className="cursor-pointer">
                    <span className="text-[10px] tracking-[0.14em] uppercase font-semibold px-2 py-0.5" style={{ color: gold, border: `1px solid ${goldLight}`, borderRadius: "2px" }}>{n.category}</span>
                    <h3 className="text-lg mt-2 mb-1" style={{ fontFamily: "'Playfair Display', serif", color: black }}>{n.title || "Untitled"}</h3>
                    <p className="text-sm text-neutral-600 leading-relaxed">{n.body}</p>
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}
